	thermal-zones {
		phandle = <0x130>;

		board-thmzone {
			phandle = <0x16d>;
			thermal-sensors = <0x15e>;
			polling-delay = <0x00>;
			polling-delay-passive = <0x00>;
		};

		cpu-thmzone {
			polling-delay-passive = <0x64>;
			polling-delay = <0x3e8>;
			sustainable-power = <0xbb8>;
			thermal-sensors = <0xae 0x00>;
			phandle = <0x131>;

			trips {

				trip-point@0 {
					temperature = <0x11170>;
					hysteresis = <0x3e8>;
					type = "passive";
					phandle = <0x132>;
				};

				trip-point@1 {
					temperature = <0x14c08>;
					hysteresis = <0x3e8>;
					type = "passive";
					phandle = <0xaf>;
				};

				bia_crit {
					temperature = <0x1adb0>;
					hysteresis = <0x7d0>;
					type = "critical";
					phandle = <0x133>;
				};
			};

			cooling-maps {

				map0 {
					trip = <0xaf>;
					contribution = <0x400>;
					cooling-device = <0xb0 0xffffffff 0xffffffff>;
				};

				map1 {
					trip = <0xaf>;
					contribution = <0x2a2>;
					cooling-device = <0xb1 0xffffffff 0xffffffff>;
				};
			};
		};

		gpu-thmzone {
			polling-delay-passive = <0x00>;
			polling-delay = <0x00>;
			thermal-sensors = <0xb2 0x00>;
			phandle = <0x134>;
		};

		test-thmzone {
			polling-delay-passive = <0x64>;
			polling-delay = <0x3e8>;
			sustainable-power = <0xbb8>;
			thermal-sensors = <0xb3 0x0c>;
			phandle = <0x135>;

			trips {

				trip-point@0 {
					temperature = <0x11170>;
					hysteresis = <0x3e8>;
					type = "passive";
					phandle = <0x136>;
				};

				trip-point@1 {
					temperature = <0x14c08>;
					hysteresis = <0x3e8>;
					type = "passive";
					phandle = <0xb4>;
				};

				bia_crit {
					temperature = <0x1adb0>;
					hysteresis = <0x7d0>;
					type = "critical";
					phandle = <0x137>;
				};
			};

			cooling-maps {

				map0 {
					trip = <0xb4>;
					contribution = <0x400>;
					cooling-device = <0xb0 0xffffffff 0xffffffff>;
				};

				map1 {
					trip = <0xb4>;
					contribution = <0x2a2>;
					cooling-device = <0xb1 0xffffffff 0xffffffff>;
				};
			};
		};
