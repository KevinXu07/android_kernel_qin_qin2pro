			label = "Power Key";
		};

		key-volumeup {
			wakeup-source;
			debounce-interval = <0x02>;
			gpios = <0x3b 0x0a 0x00>;
			linux,code = <0x73>;
			label = "Volume Up Key";
		};

		key-volumedown {
			wakeup-source;
			debounce-interval = <0x02>;
			gpios = <0xd9 0x7c 0x01>;
			linux,code = <0x72>;
			label = "Volume Down Key";
		};
	};

